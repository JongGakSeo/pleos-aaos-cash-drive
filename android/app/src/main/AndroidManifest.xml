<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- Charge port open/connected (normal): charging context for the parked bonus. -->
    <uses-permission android:name="android.car.permission.CAR_ENERGY_PORTS" />
    <!-- Pleos Connect SDK reads (all normal): odometer and trip distance, EV battery/charge port, navigation route. -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:resizeableActivity="true"
        android:usesCleartextTraffic="false"
        android:label="킬로모아"
        android:icon="@drawable/cash_drive_icon"
        android:theme="@style/AppTheme">
        <meta-data android:name="com.android.automotive" android:resource="@xml/automotive_app_desc" />
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true">
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Gleo App Schema actions (assets/schema.json, packageName ai.cashdrive.app: vehicle/showcase only).
             Started service, no permission; replies on ai.pleos.playground.intent.action.APP_ACTION_RESPONSE
             within 7 s. Reads the LOCAL_MOCK ledger only and never touches vehicle signals or credits. -->
        <receiver
            android:name=".pleos.GleoActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="CHECK_REWARD_BALANCE" />
                <action android:name="OPEN_KILOMOA" />
            </intent-filter>
        </receiver>
        <service
            android:name=".pleos.GleoActionService"
            android:exported="true">
            <intent-filter>
                <action android:name="CHECK_REWARD_BALANCE" />
                <action android:name="OPEN_KILOMOA" />
            </intent-filter>
        </service>
    </application>
</manifest>
