<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/debug_network_security_config">
        <!-- Debug launcher for the previous development screen; the demo home below is the product UI. -->
        <activity android:name=".MainActivity" android:label="Cash Drive 개발" />
        <activity android:name=".home.HomeActivity" android:exported="true" android:label="Cash Drive"
            android:process=":home" android:launchMode="singleTask" android:resizeableActivity="true"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode|fontScale">
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".RendererActivity" android:exported="false"
            android:process=":renderer" android:launchMode="singleTask" android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode|fontScale">
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
    </application>
</manifest>
